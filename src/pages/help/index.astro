---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CtaBlock from '../../components/CtaBlock.astro';

const problems = [
  { q: 'В Happ не появилась подписка', a: ['Отключите VPN и проверьте обычный интернет.', 'Удалите из Happ старую подписку, если она там осталась.', 'Снова откройте ссылку из бота и добавьте подписку.', 'Проверьте в боте, что доступ активен.'] },
  { q: 'VPN включён, но страницы не открываются', a: ['Убедитесь, что интернет работает без VPN.', 'Обновите подписку и выберите другое подключение.', 'В Happ на Windows переключите режим TUN/Proxy.', 'Откройте страницу проверки IP и убедитесь, что адрес изменился.'] },
  { q: 'Как отключить автопродление', a: ['Откройте mini app в боте.', 'На главном экране выберите «Автопродления».', 'Выберите активную подписку и отвяжите карту.'] },
];
---

<BaseLayout title="Помощь с подключением — Облепиха VPN" description="Инструкции по подключению Облепиха VPN, настройке Happ и V2RayTun, решению ошибок и управлению подпиской." canonical="/help/">
  <div class="flex min-h-screen flex-col bg-backgroundLight">
    <SiteHeader compact />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 md:py-16">
      <section class="rounded-[2.5rem] border border-primary/5 bg-card p-8 shadow-soft md:p-14">
        <p class="text-sm font-extrabold uppercase tracking-[0.17em] text-accent">Коротко и по делу</p>
        <h1 class="mt-4 text-4xl font-black text-primary md:text-6xl">Помощь с подключением</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-primary/70 md:text-xl">Основные шаги и решения частых проблем. Управление подпиской и связь с поддержкой остаются в Telegram-боте.</p>
      </section>

      <section class="py-12 md:py-16">
        <h2 class="text-3xl font-black text-primary">Первое подключение</h2>
        <div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['Откройте бота', 'Все действия с подпиской находятся в Telegram-боте Облепиха VPN.'],
            ['Выберите подписку', 'Оплатить можно банковской картой, через СБП, SberPay или T‑Pay.'],
            ['Выберите устройство', 'Бот покажет подходящее приложение и инструкцию для платформы.'],
            ['Добавьте подписку', 'Откройте выданную ссылку в приложении и включите подключение.'],
          ].map((step, index) => (
            <article class="rounded-[2rem] border border-primary/5 bg-card p-6 shadow-card">
              <span class="text-sm font-black text-accent">0{index + 1}</span>
              <h3 class="mt-4 text-xl font-black text-primary">{step[0]}</h3>
              <p class="mt-3 text-sm leading-relaxed text-primary/60">{step[1]}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="pb-14">
        <h2 class="text-3xl font-black text-primary">Быстрая помощь</h2>
        <div class="mt-7 flex flex-col gap-4">
          {problems.map((problem) => (
            <details class="group rounded-[1.5rem] border border-primary/5 bg-card open:shadow-lg">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-bold text-primary md:text-xl">{problem.q}<span class="material-symbols-outlined text-accent transition-transform group-open:rotate-180">expand_more</span></summary>
              <ol class="mx-6 mb-6 flex flex-col gap-3 border-t border-primary/5 pt-5 text-primary/70">
                {problem.a.map((item, index) => <li class="flex gap-3"><span class="font-black text-accent">{index + 1}.</span><span>{item}</span></li>)}
              </ol>
            </details>
          ))}
        </div>
      </section>

      <section class="grid gap-5 pb-14 md:grid-cols-2">
        <article class="rounded-[2rem] border border-primary/5 bg-card p-7">
          <span class="material-symbols-outlined text-3xl text-accent">tv</span>
          <h2 class="mt-4 text-2xl font-black text-primary">Smart TV</h2>
          <p class="mt-3 leading-relaxed text-primary/65">Если телевизор поддерживает VPN-приложения, установите Happ или V2RayTun. На Android TV подписку можно перенести через QR-код.</p>
          <a href="/vpn-dlya-smart-tv/" class="mt-5 inline-flex items-center gap-2 font-bold text-secondary hover:text-accent">Подробная инструкция <span class="material-symbols-outlined">arrow_forward</span></a>
        </article>
        <article class="rounded-[2rem] border border-primary/5 bg-card p-7">
          <span class="material-symbols-outlined text-3xl text-accent">router</span>
          <h2 class="mt-4 text-2xl font-black text-primary">Роутер</h2>
          <p class="mt-3 leading-relaxed text-primary/65">Универсальной инструкции нет: поддержка зависит от модели и прошивки. Напишите в бот точную модель — поддержка подскажет совместимость.</p>
        </article>
      </section>

      <CtaBlock title="Не получилось подключиться?" text="Напишите модель устройства, версию системы, город, провайдера, тип сети и приложите скриншот ошибки — так поддержка ответит быстрее." cluster="help" position="help_end" />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
