          <button type="button" class="focus-ring min-h-12 flex-1 rounded-2xl border border-primary/10 bg-white/60 px-5 py-3 font-bold text-primary hover:bg-white" data-diagnostic-next="offer" data-diagnostic-choice="app_failed">Проблема осталась</button>
        </div>
      </div>

      <div hidden data-diagnostic-panel="unstable-1" data-progress="45" data-progress-label="Проверка стабильности">
