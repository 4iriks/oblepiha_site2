---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: string;
  modified?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = '/images/og.png',
  type = 'website',
  noindex = false,
  published,
  modified,
  structuredData,
} = Astro.props;

const siteUrl = 'https://oblepiha-vpn.ru';
const canonicalUrl = canonical.startsWith('http') ? canonical : new URL(canonical, siteUrl).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
const jsonLd = structuredData ? JSON.stringify(structuredData) : undefined;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Облепиха VPN" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Облепиха VPN" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XGQN3482G8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XGQN3482G8');
    </script>

    <script is:inline>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=106091881', 'ym');
      ym(106091881, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:'dataLayer', accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/106091881" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
  </head>
  <body>
    <slot />
    <script is:inline>
      const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const pageStartedAt = performance.now();
      let attribution = {};

      const readSessionJson = (key) => {
        try {
          const value = sessionStorage.getItem(key);
          return value ? JSON.parse(value) : {};
        } catch {
          return {};
        }
      };

      const cleanLabel = (element) => (element?.dataset?.ctaLabel || element?.textContent || '')
        .trim()
        .replace(/\s+/g, ' ')
        .slice(0, 100);

      const pageContext = () => {
        const documentHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
        const viewportBottom = window.scrollY + window.innerHeight;
        const scrollDepth = documentHeight > 0
          ? Math.min(100, Math.round((viewportBottom / documentHeight) * 100))
          : 0;

        return {
          page_path: window.location.pathname,
          page_title: document.title.slice(0, 120),
          time_on_page_sec: Math.max(0, Math.round((performance.now() - pageStartedAt) / 1000)),
          scroll_depth_percent: scrollDepth,
          ...attribution
        };
      };

      const trackEvent = (eventName, details = {}) => {
        const data = { ...pageContext(), ...details };
        if (typeof window.gtag === 'function') window.gtag('event', eventName, data);
        if (typeof window.ym === 'function') window.ym(106091881, 'reachGoal', eventName, data);
      };

      window.oblepihaTrack = trackEvent;

      try {
        const params = new URLSearchParams(window.location.search);
        const campaign = Object.fromEntries(
          attributionKeys
            .map((key) => [key, params.get(key)])
            .filter(([, value]) => Boolean(value))
        );

        if (Object.keys(campaign).length > 0) {
          let landingReferrer = 'direct';
          try {
            landingReferrer = document.referrer ? new URL(document.referrer).hostname : 'direct';
          } catch {}

          attribution = {
            ...campaign,
            landing_page: window.location.pathname,
            landing_referrer: landingReferrer
          };
          sessionStorage.setItem('oblepiha_attribution', JSON.stringify(attribution));
        } else {
          const storedAttribution = sessionStorage.getItem('oblepiha_attribution');
          attribution = storedAttribution ? JSON.parse(storedAttribution) : {};
        }
      } catch {
        attribution = {};
      }

      document.addEventListener('click', function (event) {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest('[data-seo-cta]');
        if (link) {
          let startParam = '';
          try {
            startParam = new URL(link.href).searchParams.get('start') || '';
          } catch {}

          const cluster = link.dataset.cluster || 'general';
          const position = link.dataset.position || 'content';
          const offer = link.dataset.offer || 'subscription';
          const diagnostic = readSessionJson('oblepiha_diagnostic');
          const data = {
            cluster,
            cta_position: position,
            cta_id: link.dataset.ctaId || `${cluster}_${position}_${offer}`.slice(0, 100),
            cta_text: cleanLabel(link),
            offer,
            destination: 'telegram_bot',
            start_param: startParam,
            diagnostic_session_id: diagnostic.sessionId || '',
            diagnostic_symptom: diagnostic.symptom || '',
            diagnostic_last_choice: diagnostic.lastChoice || '',
            diagnostic_outcome: diagnostic.outcome || '',
            diagnostic_step_number: diagnostic.stepNumber || 0
          };
          trackEvent('bot_cta_click', data);
          trackEvent('seo_cta_click', { ...data, compatibility_event: 'legacy' });
          if (position === 'diagnostic_result') trackEvent('vpn_analyzer_bot_click', data);
          return;
        }

        const analyzerLink = event.target.closest('[data-analyzer-open], a[href="#happ-diagnostic"]');
        if (analyzerLink) {
          trackEvent('vpn_analyzer_open', {
            cta_position: analyzerLink.dataset.analyzerPosition || analyzerLink.dataset.position || 'content',
            cta_text: cleanLabel(analyzerLink),
            target: 'happ_diagnostic'
          });
          return;
        }

        const helpLink = event.target.closest('[data-help-link]');
        if (!helpLink) return;
        const helpData = {
          target_path: helpLink.getAttribute('href') || '',
          link_position: helpLink.dataset.position || 'content',
          link_text: cleanLabel(helpLink)
        };
        trackEvent('help_link_click', helpData);
      });
    </script>
  </body>
</html>
